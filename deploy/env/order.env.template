# ----------------------------
# Настройки HTTP-сервера
# ----------------------------

# Адрес, на котором будет слушать HTTP-сервер (пусто = все интерфейсы)
HTTP_HOST=${ORDER_HTTP_HOST}

# Порт, на котором будет работать HTTP-сервер
HTTP_PORT=${ORDER_HTTP_PORT}

# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=${ORDER_LOGGER_LEVEL}

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=${ORDER_LOGGER_AS_JSON}

# ----------------------------
# Настройки PostgreSQL
# ----------------------------

# Строка подключения к PostgreSQL
DB_URI=${ORDER_DB_URI}

# Директория с миграциями внутри контейнера
MIGRATIONS_DIR=${ORDER_MIGRATIONS_DIR}

# ----------------------------
# Внешние gRPC-сервисы
# ----------------------------

# Адрес inventory, к которому подключается order
INVENTORY_GRPC_HOST=${ORDER_INVENTORY_GRPC_HOST}
INVENTORY_GRPC_PORT=${ORDER_INVENTORY_GRPC_PORT}

# Адрес payment, к которому подключается order
PAYMENT_GRPC_HOST=${ORDER_PAYMENT_GRPC_HOST}
PAYMENT_GRPC_PORT=${ORDER_PAYMENT_GRPC_PORT}
