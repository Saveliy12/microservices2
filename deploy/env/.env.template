# ============================================================
# Единый шаблон конфигурации проекта.
# При первом запуске `task env:generate` копируется в .env,
# который можно править локально (он не попадает в git).
# Префикс сервиса (PAYMENT_*, INVENTORY_*...) нужен, чтобы
# переменные всех сервисов жили в одном файле без конфликтов.
# ============================================================

# ------------------------- payment --------------------------

# Адрес, на котором слушает gRPC-сервер payment (пусто = все интерфейсы)
PAYMENT_GRPC_HOST=

# Порт gRPC-сервера payment
PAYMENT_GRPC_PORT=50052

# Уровень логирования payment (debug, info, warn, error)
PAYMENT_LOGGER_LEVEL=info

# Выводить логи payment в формате JSON (true/false)
PAYMENT_LOGGER_AS_JSON=false

# ------------------------- inventory --------------------------

# Адрес, на котором слушает gRPC-сервер inventory (пусто = все интерфейсы)
INVENTORY_GRPC_HOST=

# Порт gRPC-сервера inventory
INVENTORY_GRPC_PORT=50051

# Уровень логирования inventory (debug, info, warn, error)
INVENTORY_LOGGER_LEVEL=info

# Выводить логи inventory в формате JSON (true/false)
INVENTORY_LOGGER_AS_JSON=false

# Строка подключения inventory к MongoDB
INVENTORY_MONGO_URI=mongodb://demo:demo@mongo-inventory:27017/example?authSource=admin

# Имя базы данных inventory в MongoDB
INVENTORY_MONGO_DB=example

# ------------------------- order --------------------------

# Адрес, на котором слушает HTTP-сервер order (пусто = все интерфейсы)
ORDER_HTTP_HOST=

# Порт HTTP-сервера order
ORDER_HTTP_PORT=8080

# Уровень логирования order (debug, info, warn, error)
ORDER_LOGGER_LEVEL=info

# Выводить логи order в формате JSON (true/false)
ORDER_LOGGER_AS_JSON=false

# Строка подключения order к PostgreSQL
ORDER_DB_URI=postgres://demo:demo@postgres-order:5432/postgres?sslmode=disable

# Директория с миграциями order внутри контейнера
ORDER_MIGRATIONS_DIR=/app/migrations

# Адрес inventory, к которому ходит order как gRPC-клиент
ORDER_INVENTORY_GRPC_HOST=inventory
ORDER_INVENTORY_GRPC_PORT=50051

# Адрес payment, к которому ходит order как gRPC-клиент
ORDER_PAYMENT_GRPC_HOST=payment
ORDER_PAYMENT_GRPC_PORT=50052
