# ============================================================
# Пример локального окружения (запуск сервисов без Docker).
# Скопируйте в .env:  cp .env.example .env
#
# Для Docker-окружения другой конвейер:
#   deploy/env/.env.template  →  task env:generate
# ============================================================

# ---------- inventory ----------
MONGO_URI=mongodb://demo:demo@localhost:27017/example?authSource=admin
MONGO_DB=example

# ---------- order ----------
# 5433 — порт, на который docker compose публикует postgres-order
# (5432 — если используете локальный PostgreSQL)
DB_URI=postgres://demo:demo@localhost:5433/postgres?sslmode=disable
MIGRATIONS_DIR=order/migrations

# Адреса соседних сервисов
INVENTORY_GRPC_HOST=localhost
INVENTORY_GRPC_PORT=50051
PAYMENT_GRPC_HOST=localhost
PAYMENT_GRPC_PORT=50052
